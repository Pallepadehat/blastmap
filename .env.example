# Postgres connection URL. The compose file's database is at this address.
DATABASE_URL=postgres://blastmap:blastmap@db:5432/blastmap

# At least 32 random characters, used to sign sessions and encrypt tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL people use to reach this instance, e.g. https://blastmap.example.com
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (public repositories only). Set both or neither.
GITHUB_CLIENT_ID=
# Secret for the GitHub OAuth app above.
GITHUB_CLIENT_SECRET=

# GitLab instance URL; leave empty for https://gitlab.com.
GITLAB_URL=
# GitLab OAuth application ID. Set both ID and secret, or neither.
GITLAB_CLIENT_ID=
# Secret for the GitLab application above.
GITLAB_CLIENT_SECRET=

# OpenAI-compatible endpoint base URL, e.g. https://api.openai.com/v1 or http://ollama:11434/v1. Optional; set all three or none.
AI_BASE_URL=
# API key for the AI endpoint.
AI_API_KEY=
# Model name to request from the AI endpoint.
AI_MODEL=
